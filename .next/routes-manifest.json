{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    },
    {
      "source": "/tickets",
      "destination": "/tasks",
      "statusCode": 307,
      "regex": "^(?!/_next)/tickets(?:/)?$"
    },
    {
      "source": "/tickets/join/:code",
      "destination": "/tasks/join/:code",
      "statusCode": 307,
      "regex": "^(?!/_next)/tickets/join(?:/([^/]+?))(?:/)?$"
    },
    {
      "source": "/tickets/:id",
      "destination": "/tasks/:id",
      "statusCode": 307,
      "regex": "^(?!/_next)/tickets(?:/([^/]+?))(?:/)?$"
    }
  ],
  "headers": [],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
